#include <stdio.h>
#define V 4
#define INF 999

int main(void) {
    int d[V][V] = {
        {0,   5, INF, 10},
        {INF, 0,   3, INF},
        {INF, INF, 0,   1},
        {INF, INF, INF, 0}
    };

    for (int k = 0; k < V; k++)
        for (int i = 0; i < V; i++)
            for (int j = 0; j < V; j++)
                if (d[i][k] + d[k][j] < d[i][j])
                    d[i][j] = d[i][k] + d[k][j];

    for (int i = 0; i < V; i++) {
        for (int j = 0; j < V; j++)
            printf("%3d ", d[i][j]);
        printf("\n");
    }
    return 0;
}
